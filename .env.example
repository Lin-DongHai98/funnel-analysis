# 使用方法：复制本文件并重命名为 .env，然后填入自己的数据库信息
# Windows: copy .env.example .env
# Mac/Linux: cp .env.example .env
#
# .env 已被 .gitignore 忽略，不会被提交到仓库，请勿把真实密码写进本文件。

# ---- MySQL 连接信息 ----
DB_USER=root
DB_PASSWORD=your_password_here
DB_HOST=127.0.0.1
DB_PORT=3306

# 数据库名：漏斗分析专用库，需与另一个项目（电商 RFM 分析）的库分开
# 变量名用 DB_NAME_FUNNEL 而不是 DB_NAME，是为了避免与另一个项目的
# DB_NAME（order_analysis）在同一个终端环境里互相覆盖。
DB_NAME_FUNNEL=funnel_analysis
